<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Feature 3.8 Milestone C. The only project in the solution that references the Stripe SDK,
         and it stays that way: Application talks to IPaymentGateway, Presentation cannot see this
         assembly at all, and the API keys are bound here. -->
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\FoodDeliveryService.Common.Infrastructure\FoodDeliveryService.Common.Infrastructure.csproj" />
    <ProjectReference Include="..\FoodDeliveryService.Modules.Payments.Application\FoodDeliveryService.Modules.Payments.Application.csproj" />
    <ProjectReference Include="..\FoodDeliveryService.Modules.Payments.Presentation\FoodDeliveryService.Modules.Payments.Presentation.csproj" />
    <!-- Users' contracts are not optional for any module host: GetUserPermissionsRequest is declared
         there, and this module's PermissionService and AddRequestClient<> both name it. The rest
         arrive with the consumers that handle them — Orders for the authorize/capture/release path
         (§8, §9) and Support for the approved refund (§10) — because a reference to a contract this
         module does not handle is a subscription nobody decided to make. -->
    <ProjectReference Include="..\..\Users\FoodDeliveryService.Modules.Users.IntegrationEvents\FoodDeliveryService.Modules.Users.IntegrationEvents.csproj" />
    <!-- Feature 3.8 Milestone F. OrderPlacedIntegrationEvent is what drives the authorization, so
         its contract is referenced here (ConfigureConsumers registers the consumer) as well as in
         Presentation, which holds the handler. The reverse reference already exists — Orders
         consumes this module's payment-method events — and neither creates a cycle, because an
         IntegrationEvents project references nothing but Common.Application. -->
    <ProjectReference Include="..\..\Orders\FoodDeliveryService.Modules.Orders.IntegrationEvents\FoodDeliveryService.Modules.Orders.IntegrationEvents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FoodDeliveryService.Modules.Payments.IntegrationTests" />
    <InternalsVisibleTo Include="FoodDeliveryService.Modules.Payments.UnitTests" />
  </ItemGroup>

</Project>

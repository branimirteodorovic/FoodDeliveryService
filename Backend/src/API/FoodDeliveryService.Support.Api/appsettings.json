{
  "ConnectionStrings": {
    "Database": "",
    "DatabaseMigrations": "",
    "Cache": "",
    "Queue": ""
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "",
    "TokenValidationParameters": {
      "ValidIssuers": []
    },
    "MetadataAddress": "",
    "RequireHttpsMetadata": false
  },
  "Duende": {
    "HealthUrl": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "FoodDeliveryService.Support.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",
  "MessageProcessor": {
    "Outbox": {
      "IntervalInSeconds": 1,
      "BatchSize": 50
    },
    "Inbox": {
      "IntervalInSeconds": 1,
      "BatchSize": 50
    }
  }
}

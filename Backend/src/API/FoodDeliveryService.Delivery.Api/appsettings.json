{
  "ConnectionStrings": {
    "Database": "",
    "Cache": "",
    "Queue": ""
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "",
    "TokenValidationParameters": {
      "ValidIssuers": []
    },
    "MetadataAddress": "",
    "RequireHttpsMetadata": false
  },
  "Duende": {
    "HealthUrl": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FoodDeliveryService.Delivery.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",
  "MessageProcessor": {
    "Outbox": {
      "IntervalInSeconds": 1,
      "BatchSize": 50
    },
    "Inbox": {
      "IntervalInSeconds": 1,
      "BatchSize": 50
    }
  },
  "Delivery": {
    "Assignment": {
      "OfferWindowInSeconds": 30,
      "SearchRadiusKm": 5,
      "CandidateLimit": 10,
      "ExpiredOffersJobIntervalInSeconds": 5
    }
  }
}

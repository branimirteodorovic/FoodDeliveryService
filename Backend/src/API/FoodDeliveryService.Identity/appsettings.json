{
  "ConnectionStrings": {
    "Database": ""
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "IssuerUri": ""
  },
  "Clients": {
    "Confidential": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Public": {
      "ClientId": ""
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Duende": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FoodDeliveryService.Identity"
    }
  }
}

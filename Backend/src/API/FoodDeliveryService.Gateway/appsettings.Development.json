{
  "Authentication": {
    "Audience": "fooddeliveryservice.api",
    "TokenValidationParameters": {
      "ValidIssuers": [ "http://fooddeliveryservice.identity:8080", "http://localhost:18080" ]
    },
    "MetadataAddress": "http://fooddeliveryservice.identity:8080/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://fooddeliveryservice.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FoodDeliveryService.Gateway"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://fooddeliveryservice.otel-collector:4317",
  "ReverseProxy": {
    "Routes": {
      "fooddeliveryservice-route1": {
        "ClusterId": "fooddeliveryservice-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "fooddeliveryservice-route2": {
        "ClusterId": "fooddeliveryservice-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "users/register"
        }
      },
      "fooddeliveryservice-route3": {
        "ClusterId": "fooddeliveryservice-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "users/accept-invitation"
        }
      },
      "fooddeliveryservice-notifications-route1": {
        "ClusterId": "fooddeliveryservice-notifications-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "notifications/{**catch-all}" }
        ]
      },
      "fooddeliveryservice-orders-route1": {
        "ClusterId": "fooddeliveryservice-orders-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "orders/{**catch-all}" }
        ]
      },
      "fooddeliveryservice-restaurants-route1": {
        "ClusterId": "fooddeliveryservice-restaurants-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "restaurants/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "restaurants/{**catch-all}" }
        ]
      },
      "fooddeliveryservice-delivery-route1": {
        "ClusterId": "fooddeliveryservice-delivery-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "delivery/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "delivery/{**catch-all}" }
        ]
      },
      "fooddeliveryservice-users-route1": {
        "ClusterId": "fooddeliveryservice-users-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "users/{**catch-all}" }
        ]
      },
      "fooddeliveryservice-realtime-route1": {
        "ClusterId": "fooddeliveryservice-realtime-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "hubs/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "hubs/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "fooddeliveryservice-notifications-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fooddeliveryservice.notifications.api:8080"
          }
        }
      },
      "fooddeliveryservice-orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fooddeliveryservice.orders.api:8080"
          }
        }
      },
      "fooddeliveryservice-restaurants-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fooddeliveryservice.restaurants.api:8080"
          }
        }
      },
      "fooddeliveryservice-delivery-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fooddeliveryservice.delivery.api:8080"
          }
        }
      },
      "fooddeliveryservice-users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fooddeliveryservice.users.api:8080"
          }
        }
      },
      "fooddeliveryservice-realtime-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fooddeliveryservice.realtime.api:8080"
          }
        }
      }
    }
  }
}

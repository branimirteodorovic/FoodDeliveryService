<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>63a359d1-f4ce-410a-a35a-4b27c9d84ce0</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <DockerComposeProjectPath>..\..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <!-- ConfigureOpenTelemetryTracerProvider/MeterProvider for the YARP source and meter. The
         instrumentation and exporter packages come with AddHostTelemetry (Common.Presentation). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <!-- The rate limiter's counters (Milestone G). Shared across replicas or the limit is a lie, so
         the gateway opens one connection to the Redis the platform already runs — the only piece of
         the limiter that could not live in Common.Presentation. -->
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <!-- The health-probe contract only (HealthCheckTags / AddLivenessCheck / MapHealthProbes).
         The gateway takes no Common.Infrastructure dependency — it is a proxy, not a module host. -->
    <ProjectReference Include="..\..\Common\FoodDeliveryService.Common.Presentation\FoodDeliveryService.Common.Presentation.csproj" />
  </ItemGroup>

</Project>

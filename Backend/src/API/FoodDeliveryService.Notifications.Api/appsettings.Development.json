{
  "ConnectionStrings": {
    "Database": "Host=fooddeliveryservice.database;Port=5432;Database=fooddeliveryservice_notifications;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "fooddeliveryservice.redis:6379",
    "Queue": "amqp://fooddeliveryservice.queue:5672"
  },
  "Authentication": {
    "Audience": "fooddeliveryservice.api",
    "TokenValidationParameters": {
      "ValidIssuers": [ "http://fooddeliveryservice.identity:8080", "http://localhost:18080" ]
    },
    "MetadataAddress": "http://fooddeliveryservice.identity:8080/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Duende": {
    "HealthUrl": "http://fooddeliveryservice.identity:8080/health"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "FoodDeliveryService.Modules.Notifications.Infrastructure.Outbox": "Warning",
        "FoodDeliveryService.Modules.Notifications.Infrastructure.Inbox": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://fooddeliveryservice.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FoodDeliveryService.Notifications.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://fooddeliveryservice.jaeger:4317",
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@fooddeliveryservice.local",
    "FromName": "Food Delivery Service"
  },
  "MessageProcessor": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    },
    "Inbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 20
    }
  }
}

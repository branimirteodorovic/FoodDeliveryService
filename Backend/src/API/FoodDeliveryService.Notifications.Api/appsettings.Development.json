{
  "ConnectionStrings": {
    "Database": "Host=fooddeliveryservice.database;Port=5432;Database=fooddeliveryservice;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "fooddeliveryservice.redis:6379",
    "Queue": "amqp://fooddeliveryservice-queue:5672"
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [ "http://fooddeliveryservice.identity:8080/realms/fooddeliveryservice", "http://localhost:18080/realms/fooddeliveryservice" ]
    },
    "MetadataAddress": "http://fooddeliveryservice.identity:8080/realms/fooddeliveryservice/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "http://fooddeliveryservice.identity:8080/health/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "FoodDeliveryService.Modules.Notifications.Infrastructure.Outbox": "Warning",
        "FoodDeliveryService.Modules.Notifications.Infrastructure.Inbox": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://fooddeliveryservice.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FoodDeliveryService.Notifications.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://fooddeliveryservice.jaeger:4317"
}

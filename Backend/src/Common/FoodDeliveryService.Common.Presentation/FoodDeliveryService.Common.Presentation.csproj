<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoodDeliveryService.Common.Domain\FoodDeliveryService.Common.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UIResponseWriter — the JSON payload shape the /health endpoints have always rendered.
         Lives here rather than in each host so the Gateway and Identity, which take no
         Common.Infrastructure dependency, get the probe contract from this project alone. -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
    <!-- Same reason as the health checks above: AddHostTelemetry is the OpenTelemetry baseline the
         Gateway and Identity need without becoming module hosts. AddInfrastructure builds on it. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- Serilog's LogContext + PropertyEnricher, for the request-correlation middleware every host
         shares. The sinks stay a host concern; this project only pushes properties into the scope. -->
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FoodDeliveryService.Common.UnitTests" />
  </ItemGroup>

</Project>

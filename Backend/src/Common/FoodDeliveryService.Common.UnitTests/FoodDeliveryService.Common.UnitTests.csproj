<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- AddDistributedMemoryCache / IServiceCollection / IOptions all live in the ASP.NET Core
         shared framework — referencing it here avoids pinning separate NuGet package versions
         for what the test project only uses as an in-memory ICacheService backing. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Collects metrics through a real MeterProvider, so the diagnostics tests assert what the SDK
         actually exports rather than what a raw MeterListener sees regardless of registration. -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <!-- The Prometheus rule files and the Grafana provisioning files are YAML; ObservabilityAssetTests
         parses them for real rather than pattern-matching text. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoodDeliveryService.Common.Application\FoodDeliveryService.Common.Application.csproj" />
    <ProjectReference Include="..\FoodDeliveryService.Common.Infrastructure\FoodDeliveryService.Common.Infrastructure.csproj" />
    <ProjectReference Include="..\FoodDeliveryService.Common.Presentation\FoodDeliveryService.Common.Presentation.csproj" />
  </ItemGroup>

  <!-- Feature 3.7 Milestone A. EndpointAuthorizationTests maps every module's real route table, so it
       needs the Presentation assemblies themselves: the endpoints are `internal sealed` and reach the
       route table only through AddEndpoints' reflection, which no source scan replaces. Users.Domain
       comes along for `Permission` — the seeded list every RequireAuthorization policy name is checked
       against. These are the only module references in the project and they are test-only; nothing in
       Common's product code may reference a module. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Delivery\FoodDeliveryService.Modules.Delivery.Presentation\FoodDeliveryService.Modules.Delivery.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Notifications\FoodDeliveryService.Modules.Notifications.Presentation\FoodDeliveryService.Modules.Notifications.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Orders\FoodDeliveryService.Modules.Orders.Presentation\FoodDeliveryService.Modules.Orders.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\RealTime\FoodDeliveryService.Modules.RealTime.Presentation\FoodDeliveryService.Modules.RealTime.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Restaurants\FoodDeliveryService.Modules.Restaurants.Presentation\FoodDeliveryService.Modules.Restaurants.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Support\FoodDeliveryService.Modules.Support.Presentation\FoodDeliveryService.Modules.Support.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Users\FoodDeliveryService.Modules.Users.Presentation\FoodDeliveryService.Modules.Users.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Users\FoodDeliveryService.Modules.Users.Domain\FoodDeliveryService.Modules.Users.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

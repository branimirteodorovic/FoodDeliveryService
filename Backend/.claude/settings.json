{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/activity-logger.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/activity-logger.js"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/activity-logger.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/activity-logger.js"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'REMINDER: Context was compacted. Re-read CLAUDE.md before continuing. Key rules: (1) domain logic ONLY in Domain layer, (2) Dapper for queries never EF Core, (3) cross-service communication ONLY via MassTransit/RabbitMQ with outbox/inbox (no HTTP between services, no shared DBs), (4) Duende IdentityServer for auth, YARP gateway is the only public entry, (5) each service has its own database. Reference the Users module for patterns.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/activity-logger.js"
          }
        ]
      }
    ]
  }
}

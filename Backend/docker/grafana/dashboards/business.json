{
  "uid": "fds-business",
  "title": "FoodDeliveryService — Business",
  "description": "The platform's own story rather than the host's: orders placed, where they move through the lifecycle, and how the driver-offer cycle is ending. Every measurement here is emitted from the place that already owns the state change (Milestone B), so a panel going flat means the flow stopped, not that the instrumentation broke.",
  "tags": ["fooddeliveryservice", "business"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Orders / min",
      "description": "The headline number. orders.placed is recorded from OrderPlacedDomainEventHandler, i.e. after the order is committed and its outbox row dispatched — it counts orders that really exist, not requests that were accepted.",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 1 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum(rate(orders_placed_total[$__rate_interval]))",
          "legendFormat": "orders/min",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Orders placed (window)",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(orders_placed_total[$__range]))",
          "legendFormat": "placed",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cancellation share",
      "description": "Cancellations as a share of placements over the dashboard window. from=Pending and from=Accepted are both legal sources and the distinction is on the transitions panel below.",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum(increase(orders_state_transition_total{to=\"Canceled\"}[$__range])) / sum(increase(orders_placed_total[$__range]))",
          "legendFormat": "canceled",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Offers finding no driver",
      "description": "delivery.assignment.outcome{outcome=\"no_driver\"} as a share of the turns that actually searched — offered, no_driver and failed. lock_contended, not_pending and expired are excluded because none of them ran a candidate search.",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum(increase(delivery_assignment_outcome_total{outcome=\"no_driver\"}[$__range])) / sum(increase(delivery_assignment_outcome_total{outcome=~\"offered|no_driver|failed\"}[$__range]))",
          "legendFormat": "no driver",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Order lifecycle",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Orders placed / min",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum(rate(orders_placed_total[$__rate_interval]))",
          "legendFormat": "orders/min",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Lifecycle transitions / min",
      "description": "Every transition the aggregate makes, tagged with the status it came from — the panel that answers \"where do orders stall?\". from=none is placement, which starts the lifecycle rather than moving through it.",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum by (from, to) (rate(orders_state_transition_total[$__rate_interval]))",
          "legendFormat": "{{from}} → {{to}}",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Transitions in window",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (from, to) (increase(orders_state_transition_total[$__range]))",
          "legendFormat": "{{from}} → {{to}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Driver assignment",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Assignment outcomes / min",
      "description": "A rising lock_contended is the early warning that the 5 s offer lock is too coarse — it is invisible in every other signal. not_pending is idempotent re-entry and is healthy. expired belongs to a PREVIOUS offer and is counted by the expiry job at detection.",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum by (outcome) (rate(delivery_assignment_outcome_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Assignment duration p95 by outcome",
      "description": "Split by outcome on purpose: a lock_contended turn returns in microseconds and would otherwise drag the p50 of the real work down with it.",
      "datasource": {
        "type": "prometheus",
        "uid": "fooddelivery-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(delivery_assignment_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 23,
      "type": "text",
      "title": "Reading these two instruments",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 31 },
      "options": {
        "mode": "markdown",
        "content": "`delivery.assignment.outcome` and `delivery.assignment.duration` **do not share a denominator.** The histogram measures one turn of `DeliveryAssignmentService.OfferNextAsync`; the counter additionally carries `expired`, which the expiry job records for a *previous* offer that lapsed, and the re-offer it triggers is counted separately on its own turn.\n\nRead the counter **per outcome**, never as a total — a ratio built on `sum(...)` across all outcomes double-counts a delivery that was offered, expired and re-offered."
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Support & ticketing",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Tickets opened / min by category",
      "description": "support.tickets.opened, recorded last in TicketOpenedDomainEventHandler. Read as a product signal before a staffing one: a rising FoodQuality or ItemMissing line is a restaurant problem arriving through the support queue.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum by (category) (rate(support_tickets_opened_total[$__rate_interval]))",
          "legendFormat": "{{category}}",
          "range": true
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Ticket transitions / min",
      "description": "support.tickets.transition, tagged with the statuses moved between. Unlike the order graph there is no from=none edge: a ticket cannot be born mid-lifecycle, so the opening edge is the counter above.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum by (from, to) (rate(support_tickets_transition_total[$__rate_interval]))",
          "legendFormat": "{{from}} → {{to}}",
          "range": true
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Time to resolution p50 / p95",
      "description": "Both quantiles on purpose, for the same reason the load report leads with p95: the median is the experience a typical customer had, and the gap to p95 is the tail that a mean would hide entirely.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(support_tickets_resolution_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, category) (rate(support_tickets_resolution_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{category}}",
          "range": true
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Refund decisions in window",
      "description": "support.refunds.decided, tagged approved or rejected. The ratio is the signal, not the total: a queue approving everything is not applying a policy, and one approving nothing is not resolving anything. Since Feature 3.8 an approval moves real money — the Payments service refunds the captured card payment behind it — so this panel counts decisions, not settlements.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (outcome) (increase(support_refunds_decided_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "Payments",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Authorizations / min",
      "description": "payments.authorized against payments.failed, both recorded last in their domain-event handlers. The reason breakdown is what makes a spike actionable: insufficient_funds is the customers' problem, gateway_error is ours, and no_payment_method is Orders' CanPayByCard replica lagging behind a card that was just detached.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum(rate(payments_authorized_total[$__rate_interval]))",
          "legendFormat": "authorized",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "60 * sum by (reason) (rate(payments_failed_total[$__rate_interval]))",
          "legendFormat": "failed · {{reason}}",
          "range": true
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Money movement / min",
      "description": "The three things that can happen to a hold once it is placed. Captured is the only one where money actually leaves the customer; released is the hold given up uncharged when the restaurant rejected the order or the customer cancelled it, and no statement of theirs ever shows it. A persistent gap between this panel's captured line and the authorized line beside it is orders sitting unaccepted.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "60 * sum(rate(payments_captured_total[$__rate_interval]))",
          "legendFormat": "captured",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "60 * sum by (trigger) (rate(payments_released_total[$__rate_interval]))",
          "legendFormat": "released · {{trigger}}",
          "range": true
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "60 * sum(rate(refunds_settled_total[$__rate_interval]))",
          "legendFormat": "refunded",
          "range": true
        }
      ]
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Stripe call duration p95",
      "description": "payments.gateway.duration, measured around the single seam every provider call passes through. Split by operation because the operations are not comparable — a refund is not an authorize — and by outcome because a refusal comes back in one normal round trip while a fault comes back after the SDK's own retries. A rising p95 with a flat refusal rate is Stripe being slow, not customers being declined.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 62 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(payments_gateway_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{operation}}",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(payments_gateway_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "Webhook processing lag",
      "description": "How long a verified Stripe event waited between being recorded by the endpoint and being acted on by the outbox. A second or so is the design — the endpoint returns 2xx fast on purpose. A lag that grows means the confirmations Stripe sends are queueing, and on this service those confirmations are the only recovery path there is: neither the outbox nor the inbox job retries a failed dispatch.",
      "datasource": { "type": "prometheus", "uid": "fooddelivery-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 62 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, event_type) (rate(payments_webhook_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{event_type}}",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(payments_webhook_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        }
      ]
    }
  ]
}
